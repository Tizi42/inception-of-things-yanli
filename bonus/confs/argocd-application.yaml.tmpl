apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: iot-app-gitlab
  namespace: argocd
spec:
  project: default
  source:
    repoURL: __REPO_URL__
    targetRevision: main
    path: .
  destination:
    server: https://kubernetes.default.svc
    namespace: dev
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 12
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 2m

